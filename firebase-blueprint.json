{
  "entities": {
    "Project": {
      "title": "Project",
      "description": "A creative or talent management project",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "client": { "type": "string" },
        "brand": { "type": "string" },
        "runningDate": { "type": "string", "format": "date-time" },
        "revenue": { "type": "number" },
        "payout": { "type": "number" },
        "profit": { "type": "number" },
        "category": { "type": "string", "enum": ["PIC", "Job Partner", "Job Vendor"] },
        "status": { "type": "string", "enum": ["WAIT", "BOOKING", "FIXED/RUNNING", "FINALIZED"] },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" },
        "createdBy": { "type": "string" }
      },
      "required": ["name", "client", "brand", "runningDate", "revenue", "payout", "status", "category"]
    }
  },
  "firestore": {
    "/projects/{projectId}": {
      "schema": "Project",
      "description": "Collection of all management projects"
    }
  }
}
